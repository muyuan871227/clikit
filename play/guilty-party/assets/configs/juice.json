    "juice_destroy_evidence": {
      "sound": "sfx_match_burn",
      "particle": "particle_burn_ash",
      "flash_color": "#FF4500",
      "flash_ms": 400,
      "screen_shake": 5
    },
    "juice_lens_pickup": {
      "sound": "sfx_chime_bright",
