    "juice_frame_placed": {
      "sound": "sfx_dark_whisper",
      "particle": "particle_shadow_swirl",
      "flash_color": "#8B0000",
      "flash_ms": 250,
      "screen_shake": 3,
      "ui_popup": "popup_frame_placed"
    },
    "juice_tamper": {
      "sound": "sfx_pen_scratch",
      "particle": "particle_ink_drop",
      "flash_color": "#4B0082",
      "flash_ms": 200
